{
  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",	  
    "interval": 2,
    "warning-threshold": 80,
    "critical-threshold": 95, 
    "format": "{icon} {temperatureC}",
    "format-warning": "{icon} {temperatureC}",
    "format-critical": "{icon} {temperatureC}",
    "format-icons": "",
    "tooltip": false
  }
}

