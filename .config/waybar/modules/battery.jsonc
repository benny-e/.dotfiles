{
  "battery": {
    "states": {
      "warning": 70,
      "critical": 20

    },
    "format": "{icon} {capacity}",
    "format-charging": "󰂄 {capacity}",
    "format-plugged": " {capacity}",
    "format-warning": "{icon} {capacity}",
    "format-critical": "{icon} {capacity}", 
    "format-icons": [
      "󰂎","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"
    ],
    "events": {
		"on-discharging-critical": "notify-send -u critical 'Battery Critial (20%)'",
		"on-charging-100": "notify-send 'Battery Full (100%)'"
    }
  }
}

